# One key is enough — provider is auto-detected from the key format:
#   sk-ant-...  -> Anthropic (Claude)
#   sk-...      -> OpenAI (ChatGPT)
#   other       -> Google Gemini
# LLM_API_KEY takes priority; the provider-specific vars below also work.
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
