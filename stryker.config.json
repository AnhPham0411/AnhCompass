{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "mutate": [
    "packages/core/src/**/*.ts",
    "packages/graph/src/**/*.ts",
    "!packages/**/*.d.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 70
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ]
}
